@model IEnumerable<ClubManagement.Models.Club>

@{
    ViewData["Title"] = "Quản lý nhóm - CLB Văn Nghệ";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Account"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Quay lại quản trị
        </a>

        <h1 class="mb-2">Các Nhóm Chuyên Môn</h1>

        <p class="text-muted mb-0">
            Xem và quản lý thông tin các nhóm thuộc Câu Lạc Bộ Văn Nghệ (Nhóm Hát, Múa, Nhảy, Kịch...).
        </p>
    </div>

    <div class="page-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <h5 class="mb-0">Danh sách nhóm</h5>

            <a asp-action="Create" class="btn btn-success">
                + Thêm Nhóm
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover custom-table">
                <thead>
                    <tr>
                        <th>Tên nhóm</th>
                        <th>Mô tả</th>
                        <th>Ngày thành lập</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ClubName</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedDate.ToShortDateString()</td>

                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.ClubId"
                                           class="btn btn-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.ClubId"
                                           class="btn btn-info btn-sm">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.ClubId"
                                           class="btn btn-danger btn-sm">
                                            Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <p class="mb-1 fw-bold">
                                    Chưa có nhóm nào
                                </p>

                                <span class="text-muted">
                                    Nhấn "+ Thêm Nhóm" để tạo nhóm chuyên môn mới.
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>