@model ClubManagement.Models.ClubActivity

@{
    ViewData["Title"] = "Thêm hoạt động";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        ← Quay lại danh sách
    </a>
</div>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Thêm hoạt động</h1>
    <p class="text-secondary mb-0">Tạo một hoạt động hoặc chương trình mới cho nhóm.</p>
</div>

<div class="content-card p-4 p-md-5">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="mb-4">
            <label asp-for="ActivityName" class="form-label fw-semibold">Tên hoạt động</label>
            <input asp-for="ActivityName" class="form-control fs-6" placeholder="Ví dụ: Đêm nhạc chào tân sinh viên" />
            <span asp-validation-for="ActivityName" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
            <textarea asp-for="Description" rows="4" class="form-control fs-6" placeholder="Nội dung, yêu cầu tham gia..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Location" class="form-label fw-semibold">Địa điểm</label>
                <input asp-for="Location" class="form-control fs-6" placeholder="Ví dụ: Hội trường A" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ActivityDate" class="form-label fw-semibold">Ngày tổ chức</label>
                <input asp-for="ActivityDate" class="form-control fs-6" />
                <span asp-validation-for="ActivityDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="ClubId" class="form-label fw-semibold">Nhóm</label>
            <select asp-for="ClubId" asp-items="ViewBag.Clubs" class="form-select fs-6"></select>
            <span asp-validation-for="ClubId" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary px-4 fw-semibold">Lưu hoạt động</button>
            <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}