@model ClubManagement.Models.Club

@{
    ViewData["Title"] = "Sửa nhóm - " + Model.ClubName;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        ← Quay lại danh sách
    </a>
</div>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Sửa nhóm</h1>
    <p class="text-secondary mb-0">Cập nhật thông tin của <strong>@Model.ClubName</strong>.</p>
</div>

<div class="content-card p-4 p-md-5">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ClubId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="mb-4">
            <label asp-for="ClubName" class="form-label fw-semibold">Tên nhóm</label>
            <input asp-for="ClubName" class="form-control form-control-lg fs-6" placeholder="Nhập tên nhóm..." />
            <span asp-validation-for="ClubName" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
            <textarea asp-for="Description" rows="4" class="form-control fs-6" placeholder="Nhập mô tả nhóm..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="CreatedDate" class="form-label fw-semibold">Ngày thành lập</label>
            <input asp-for="CreatedDate" class="form-control fs-6" />
            <span asp-validation-for="CreatedDate" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary px-4 fw-semibold">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}