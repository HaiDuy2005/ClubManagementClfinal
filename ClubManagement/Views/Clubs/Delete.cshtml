@model ClubManagement.Models.Club

@{
    ViewData["Title"] = "Xóa nhóm - " + Model.ClubName;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        ← Quay lại danh sách
    </a>
</div>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Xóa nhóm</h1>
    <p class="text-secondary mb-0">Hành động này không thể hoàn tác.</p>
</div>

<div class="content-card p-4 p-md-5">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

    <div class="alert alert-danger p-3 mb-4 rounded-3 d-flex align-items-center gap-3">
        <span class="fs-4">⚠️</span>
        <div>
            <strong>Lưu ý quản trị:</strong> Bạn có chắc chắn muốn xóa <strong>@Model.ClubName</strong>?
            Hệ thống sẽ tự động dọn dẹp toàn bộ thành viên và các hoạt động liên quan đến nhóm này.
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Tên nhóm</div>
            <div class="fs-6 text-dark fw-semibold">@Model.ClubName</div>
        </div>

        <div class="col-md-6">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Ngày thành lập</div>
            <div class="fs-6 text-dark">@Model.CreatedDate.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="col-12">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Mô tả</div>
            <div class="fs-6 text-dark">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2 pt-3">
        <input type="hidden" asp-for="ClubId" />
        <button type="submit" class="btn btn-danger px-4 fw-semibold">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
    </form>
</div>