@model IEnumerable<ClubManagement.Models.MemberRegistration>

@{
    ViewData["Title"] = "Danh Sách Đăng Ký";

    var searchName = ViewBag.SearchName as string ?? "";
    var searchStudentCode = ViewBag.SearchStudentCode as string ?? "";
    var searchClass = ViewBag.SearchClass as string ?? "";
    var searchEmail = ViewBag.SearchEmail as string ?? "";
    var searchStatus = ViewBag.SearchStatus as string ?? "All";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <a asp-controller="Account"
   asp-action="Dashboard"
   class="btn btn-outline-secondary">
     Quay lại quản trị
</a>

        <div>
            <h1>Danh Sách Đăng Ký Tham Gia CLB</h1>
            <p class="text-muted mb-0">
                Tra cứu và xử lý đơn đăng ký thành viên.
            </p>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["AdminSuccess"]
        </div>
    }

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["AdminError"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Tìm kiếm đơn đăng ký</h5>

            <form asp-controller="MemberRegistration"
                  asp-action="AdminList"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Họ tên</label>
                        <input type="text"
                               name="searchName"
                               value="@searchName"
                               class="form-control"
                               placeholder="Nhập họ tên..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Mã sinh viên</label>
                        <input type="text"
                               name="searchStudentCode"
                               value="@searchStudentCode"
                               class="form-control"
                               placeholder="Nhập mã sinh viên..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lớp</label>
                        <input type="text"
                               name="searchClass"
                               value="@searchClass"
                               class="form-control"
                               placeholder="Nhập tên lớp..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="text"
                               name="searchEmail"
                               value="@searchEmail"
                               class="form-control"
                               placeholder="Nhập email..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Trạng thái</label>
                        <select name="searchStatus" class="form-select">
                            <option value="All"
                                    selected="@(searchStatus == "All")">
                                Tất cả trạng thái
                            </option>

                            <option value="Pending"
                                    selected="@(searchStatus == "Pending")">
                                Chờ duyệt
                            </option>

                            <option value="Approved"
                                    selected="@(searchStatus == "Approved")">
                                Đã duyệt
                            </option>

                            <option value="Rejected"
                                    selected="@(searchStatus == "Rejected")">
                                Đã từ chối
                            </option>
                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-controller="MemberRegistration"
                       asp-action="AdminList"
                       class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </div>

            </form>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Kết quả đăng ký</h5>

        <span class="badge bg-primary">
            @Model.Count() đơn đăng ký
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm">

            <thead class="table-dark">
                <tr>
                    <th>Họ tên</th>
                    <th>MSSV</th>
                    <th>Lớp</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.StudentCode</td>
                            <td>@item.ClassName</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>

                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Chờ duyệt
                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Đã duyệt
                                    </span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Đã từ chối
                                    </span>
                                }
                                else
                                {
                                    @item.Status
                                }
                            </td>

                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <form asp-controller="MemberRegistration"
                                          asp-action="Approve"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.RegistrationId" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Đồng ý
                                        </button>
                                    </form>

                                    <form asp-controller="MemberRegistration"
                                          asp-action="Reject"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.RegistrationId" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Từ chối
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span>Đã xử lý</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <p class="fw-bold mb-1">
                                Không tìm thấy đơn đăng ký
                            </p>

                            <span class="text-muted">
                                Hãy thử thay đổi điều kiện tìm kiếm.
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>