
@model IEnumerable<ClubManagement.Models.ActivityRegistration>

@{
    ViewData["Title"] = "Danh sách đăng ký hoạt động";

    var searchName = ViewBag.SearchName as string ?? "";
    var searchEmail = ViewBag.SearchEmail as string ?? "";
    var searchActivity = ViewBag.SearchActivity as string ?? "";
    var searchStatus = ViewBag.SearchStatus as string ?? "All";
}

<div class="page-card">

    <div class="mb-3">
        <a asp-controller="Account"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Quay lại quản trị
        </a>
    </div>

    <div class="mb-4">
        <h1>Danh sách đăng ký hoạt động</h1>
        <p class="text-muted mb-0">
            Tra cứu và duyệt đăng ký tham gia hoạt động của sinh viên.
        </p>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["AdminSuccess"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["AdminError"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="ActivityRegistration"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Họ tên sinh viên</label>
                <input type="text"
                       name="searchName"
                       value="@searchName"
                       class="form-control"
                       placeholder="Nhập họ tên..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input type="text"
                       name="searchEmail"
                       value="@searchEmail"
                       class="form-control"
                       placeholder="Nhập email..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tên hoạt động</label>
                <input type="text"
                       name="searchActivity"
                       value="@searchActivity"
                       class="form-control"
                       placeholder="Nhập tên hoạt động..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select name="searchStatus" class="form-select">
                    <option value="All"
                            selected="@(searchStatus == "All")">
                        Tất cả
                    </option>

                    <option value="Pending"
                            selected="@(searchStatus == "Pending")">
                        Chờ duyệt
                    </option>

                    <option value="Approved"
                            selected="@(searchStatus == "Approved")">
                        Đã duyệt
                    </option>
                </select>
            </div>

        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a asp-controller="ActivityRegistration"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Làm mới
            </a>
        </div>

    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Kết quả đăng ký</h5>

        <span class="badge bg-primary">
            @Model.Count() đăng ký
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Hoạt động</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.ActivityName</td>

                            <td>
                                @if (item.IsApproved)
                                {
                                    <span class="badge bg-success">
                                        Đã duyệt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Chờ duyệt
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!item.IsApproved)
                                {
                                    <form asp-controller="ActivityRegistration"
                                          asp-action="Approve"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.RegistrationId" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Duyệt
                                        </button>
                                    </form>
                                }

                                <form asp-controller="ActivityRegistration"
                                      asp-action="Delete"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn đăng ký của @item.FullName không?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.RegistrationId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            <p class="fw-bold mb-1">
                                Không tìm thấy đăng ký
                            </p>

                            <span class="text-muted">
                                Hãy thử thay đổi điều kiện tìm kiếm.
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>
