@{
    var isSignedInAdmin = Context.Session.GetString("Admin") != null;
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoginScreen = controllerName == "Account" && actionName == "Login";
    var isHomeScreen = controllerName == "Home" && actionName == "Index";
    var isAdminScreen = isSignedInAdmin && !(controllerName == "Home" || isLoginScreen);
    var bodyClass = isAdminScreen ? "admin-app" : "public-app";
    if (isHomeScreen) { bodyClass += " page-home"; }
    if (isLoginScreen) { bodyClass += " page-login"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0912" />
    <title>@ViewData["Title"] - CLB Văn Nghệ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClubManagement.styles.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
@if (isAdminScreen)
{
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-brand" asp-controller="Account" asp-action="Dashboard">
                <img src="~/images/logo.svg" asp-append-version="true" alt="Logo CLB Văn nghệ" />
                <span><strong>Văn Nghệ</strong><small>KHÔNG GIAN QUẢN TRỊ</small></span>
            </a>
            <div class="sidebar-caption">TỔNG QUAN</div>
            <nav class="sidebar-nav" data-glide aria-label="Tổng quan">
                <a class="sidebar-link @(controllerName == "Account" && actionName == "Dashboard" ? "active" : "")" asp-controller="Account" asp-action="Dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Bảng điều khiển</a>
            </nav>
            <div class="sidebar-caption">QUẢN LÝ CÂU LẠC BỘ</div>
            <nav class="sidebar-nav" data-glide aria-label="Quản lý câu lạc bộ">
                <a class="sidebar-link @(controllerName == "Members" ? "active" : "")" asp-controller="Members" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.4c1.9.8 3 2.7 3 5.6"/></svg>Thành viên</a>
                <a class="sidebar-link @(controllerName == "Clubs" ? "active" : "")" asp-controller="Clubs" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/></svg>Thông tin câu lạc bộ</a>
                <a class="sidebar-link @(controllerName == "ClubActivities" ? "active" : "")" asp-controller="ClubActivities" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 2.5v4M16 2.5v4"/></svg>Hoạt động</a>
                <a class="sidebar-link @(controllerName == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="m8.5 12 2.3 2.3L15.5 9.5"/></svg>Điểm danh</a>
                <a class="sidebar-link @(controllerName == "MemberRegistration" ? "active" : "")" asp-controller="MemberRegistration" asp-action="AdminList"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="8" r="3.5"/><path d="M3 20c0-3.6 3-6 7-6M18 14v6M15 17h6"/></svg>Đơn đăng ký thành viên</a>
                <a class="sidebar-link @(controllerName == "ActivityRegistration" ? "active" : "")" asp-controller="ActivityRegistration" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Đăng ký hoạt động</a>
                <a class="sidebar-link @(controllerName == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="AdminList"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>Liên hệ</a>
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-user"><span class="user-avatar">@((Context.Session.GetString("Admin") ?? "A").Substring(0, 1).ToUpper())</span><span><strong>@Context.Session.GetString("Admin")</strong><small>Quản trị viên</small></span></div>
                <a class="sidebar-public-link" asp-controller="Home" asp-action="Index">Xem trang công khai</a>
                <a class="sidebar-logout" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
            </div>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-controls="adminSidebar" aria-expanded="false" aria-label="Mở menu quản trị"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
                <div class="topbar-crumbs"><span class="topbar-context">CLB VĂN NGHỆ</span><span class="topbar-divider">/</span><span class="topbar-title">@ViewData["Title"]</span></div>
                <a asp-controller="Home" asp-action="Index" class="topbar-public">Trang công khai <span aria-hidden="true">↗</span></a>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
            <footer class="admin-footer"><span>© @DateTime.Now.Year CLB Văn Nghệ Sinh Viên</span><span>Không gian quản trị câu lạc bộ</span></footer>
        </div>
    </div>
}
else if (isLoginScreen)
{
    <main class="site-main">@RenderBody()</main>
}
else
{
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container nav-shell">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img class="club-logo brand-logo" src="~/images/logo.svg" asp-append-version="true" alt="Logo CLB Văn nghệ" width="42" height="42" />
                    <span class="brand-copy">CLB VĂN NGHỆ<small>STUDENT CREATIVE CLUB</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-lg-center" data-glide>
                        <li class="nav-item"><a class="nav-link nav-home-back" asp-controller="Home" asp-action="Index"><span aria-hidden="true">⌂</span><span>Trang chủ</span></a></li>
                        <li class="nav-item"><a class="nav-link @(controllerName == "Home" && actionName == "Activities" ? "active" : "")" asp-controller="Home" asp-action="Activities">Hoạt động</a></li>
                        <li class="nav-item"><a class="nav-link @(controllerName == "MemberRegistration" ? "active" : "")" asp-controller="MemberRegistration" asp-action="Create">Tham gia CLB</a></li>
                        <li class="nav-item"><a class="nav-link @(controllerName == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Create">Điểm danh</a></li>
                        <li class="nav-item"><a class="nav-link @(controllerName == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Create">Liên hệ</a></li>
                        <li class="nav-item ms-lg-3"><a class="nav-link nav-admin" asp-controller="Account" asp-action="Login"><span>Quản trị</span><span aria-hidden="true">↗</span></a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (isHomeScreen)
    {
        <main class="site-main">@RenderBody()</main>
    }
    else
    {
        <main class="site-main"><div class="container page-container">@RenderBody()</div></main>
    }
    <footer class="site-footer">
        <div class="container">
            <div class="footer-main">
                <div><div class="footer-brand"><img class="club-logo club-logo-footer" src="~/images/logo.svg" asp-append-version="true" alt="Logo CLB Văn nghệ" width="44" height="44" />CLB VĂN NGHỆ</div><p class="footer-copy">Nơi đam mê gặp gỡ, ý tưởng thành hình và mỗi sinh viên tìm thấy sân khấu của riêng mình.</p></div>
                <div class="footer-links"><span class="footer-heading">KHÁM PHÁ</span><a asp-controller="Home" asp-action="Activities">Hoạt động</a><a asp-controller="MemberRegistration" asp-action="Create">Đăng ký thành viên</a><a asp-controller="Contact" asp-action="Create">Liên hệ câu lạc bộ</a></div>
                <div class="footer-contact"><span class="footer-heading">KẾT NỐI VỚI CHÚNG TÔI</span><p>Email: clbvannghe@edu.vn</p><p>Hệ thống quản lý CLB Văn Nghệ</p><a asp-controller="Account" asp-action="Login">Khu vực quản trị ↗</a></div>
            </div>
            <div class="footer-bottom"><span>© @DateTime.Now.Year CLB Văn Nghệ Sinh Viên</span><span>ĐƯỢC TẠO NÊN TỪ ĐAM MÊ <b>✳</b></span></div>
        </div>
    </footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
