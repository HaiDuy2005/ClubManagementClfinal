@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="record-page">
    <header class="record-head">
        <h1>Đã xảy ra lỗi</h1>
        <p class="text-muted">Hệ thống không thể xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>
    </header>

    <div class="record-card danger-card">
        @if (Model.ShowRequestId)
        {
            <p class="mb-3"><strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code></p>
        }
        <p class="mb-0 text-muted">Nếu lỗi vẫn tiếp diễn, hãy gửi mã yêu cầu ở trên cho quản trị viên để được hỗ trợ.</p>
        <div class="form-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Về trang chủ</a>
        </div>
    </div>
</div>
