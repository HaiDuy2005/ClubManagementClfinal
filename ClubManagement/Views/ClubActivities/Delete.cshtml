@model ClubManagement.Models.ClubActivity

@{
    ViewData["Title"] = "Xóa hoạt động - " + Model.ActivityName;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        ← Quay lại danh sách
    </a>
</div>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Xóa hoạt động</h1>
    <p class="text-secondary mb-0">Hành động này không thể hoàn tác.</p>
</div>

<div class="content-card p-4 p-md-5">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

    <div class="alert alert-warning p-3 mb-4 rounded-3 d-flex align-items-center gap-3">
        <span class="fs-4">⚠️</span>
        <div>
            <strong>Xác nhận xóa:</strong> Bạn có chắc chắn muốn xóa hoạt động <strong>@Model.ActivityName</strong>?
            Dữ liệu đăng ký và điểm danh của riêng hoạt động này sẽ bị xoá. Thông tin Nhóm và Thành viên vẫn giữ nguyên.
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Tên hoạt động</div>
            <div class="fs-6 text-dark fw-semibold">@Model.ActivityName</div>
        </div>

        <div class="col-md-6">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Địa điểm</div>
            <div class="fs-6 text-dark">
                @(string.IsNullOrWhiteSpace(Model.Location) ? "Chưa cập nhật" : Model.Location)
            </div>
        </div>

        <div class="col-md-6">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Ngày tổ chức</div>
            <div class="fs-6 text-dark">@Model.ActivityDate.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="col-12">
            <div class="text-uppercase small fw-bold text-secondary mb-1">Mô tả</div>
            <div class="fs-6 text-dark">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2 pt-3">
        <input type="hidden" asp-for="ActivityId" />
        <button type="submit" class="btn btn-danger px-4 fw-semibold">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
    </form>
</div>