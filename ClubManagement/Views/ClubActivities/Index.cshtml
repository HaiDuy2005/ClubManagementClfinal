@model IEnumerable<ClubManagement.Models.ClubActivity>

@{
    ViewData["Title"] = "Danh Sách Hoạt Động";

    var searchName = ViewBag.SearchName as string ?? "";
    var searchLocation = ViewBag.SearchLocation as string ?? "";
    var searchDate = ViewBag.SearchDate as string ?? "";
}

<div class="container py-4">

    <div class="mb-4">
       <a asp-controller="Account"
   asp-action="Dashboard"
   class="btn btn-outline-secondary">
     Quay lại quản trị
</a>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1>Danh Sách Hoạt Động</h1>
                <p class="text-muted mb-0">
                    Tìm kiếm và quản lý các hoạt động của CLB Văn Nghệ.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-success">
                Thêm Hoạt Động
            </a>
        </div>
    </div>

    <div class="page-card">

        <form asp-controller="ClubActivities"
              asp-action="Index"
              method="get"
              class="mb-4">

            <h5 class="mb-3">Tìm kiếm hoạt động</h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Tên hoạt động</label>
                    <input type="text"
                           name="searchName"
                           value="@searchName"
                           class="form-control"
                           placeholder="Nhập tên hoạt động..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Địa điểm</label>
                    <input type="text"
                           name="searchLocation"
                           value="@searchLocation"
                           class="form-control"
                           placeholder="Nhập địa điểm..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Ngày tổ chức</label>
                    <input type="date"
                           name="searchDate"
                           value="@searchDate"
                           class="form-control" />
                </div>

            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    Tìm kiếm
                </button>

                <a asp-controller="ClubActivities"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Làm mới
                </a>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Danh sách hoạt động</h5>

            <span class="badge bg-primary">
                @Model.Count() hoạt động
            </span>
        </div>

        <div class="table-responsive">
            <table class="table custom-table">

                <thead>
                    <tr>
                        <th>Tên Hoạt Động</th>
                        <th>Mô Tả</th>
                        <th>Địa Điểm</th>
                        <th>Ngày Tổ Chức</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ActivityName</td>
                                <td>@item.Description</td>
                                <td>@item.Location</td>
                                <td>@item.ActivityDate.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <div class="d-flex flex-wrap gap-1">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ActivityId"
                                           class="btn btn-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.ActivityId"
                                           class="btn btn-info btn-sm">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.ActivityId"
                                           class="btn btn-danger btn-sm">
                                            Xóa
                                        </a>

                                        <a asp-action="Participants"
                                           asp-route-id="@item.ActivityId"
                                           class="btn btn-info btn-sm">
                                            Sinh viên tham gia
                                        </a>

                                        <a asp-controller="ActivityRegistration"
                                           asp-action="Create"
                                           asp-route-id="@item.ActivityId"
                                           class="btn btn-success btn-sm">
                                            Đăng ký
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <p class="mb-1 fw-bold">
                                    Không tìm thấy hoạt động
                                </p>

                                <span class="text-muted">
                                    Hãy thử thay đổi tên hoạt động, địa điểm
                                    hoặc ngày tổ chức.
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>